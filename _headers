# Netlify / Cloudflare Pages. Rules must not overlap (both hosts merge duplicate headers).
/wp-content/themes/emg-topas/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/emg-topas/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/emg-topas/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/emg-topas/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/emg-topas/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
